--- !u!114 &1484042865
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1484042864}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cd41559234e3f844e86d60dddf735061, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textPanel: {fileID: 1820072878}
  introText: {fileID: 1546982663}
  slides:
  - visual: {fileID: 586739350}
    text: 'The unbeatable!

      The master illusionist!

      Our magician, Fabio!'
  - visual: {fileID: 826560005}
    text: 'The leader of all parades!

      Steps stiff as wood!

      Our majorette,
      Valerie!'
  - visual: {fileID: 1505686639}
    text: 'The Magnificent Jack!

      Strongest man in our surroundings!

      Our
      strongman!'
  - visual: {fileID: 1284524876}
    text: 'The funniest for all crowds!

      Effortlessly hilarious!

      Our
      clown, Jerry!'
  - visual: {fileID: 602282290}
    text: 'The fearless!

      The ruler of all wild!

      Our lion tamer, Roxanne!'
  - visual: {fileID: 101565422}
    text: 'Light as a feather!

      Precise as a needle!

      Our tightrope walker,
      Celeste!'
  - visual: {fileID: 47381804}
    text: 'The trickster!

      The amusing!

      Our lively jester, Morgan!'
  - visual: {fileID: 890601769}
    text: 'And, of course, I

      The greatest ring master,

      The Big Maximilian!'
  typingSpeed: 0.04
